{
  "name": "booking-web-manager",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "predev": "npm run build-storybook:public",
    "dev": "next dev",
    "build": "npm run build-storybook:public && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:concurrency": "vitest run --project unit -t concurrency",
    "test:e2e": "npm run build && playwright test",
    "test:integration": "node scripts/test-session-integration.mjs db",
    "test:e2e:integration": "node scripts/test-session-integration.mjs http",
    "test:e2e:authenticated": "npm run build && playwright test --config playwright.integration.config.ts",
    "test:sessions:integration": "node scripts/test-session-integration.mjs all",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build-storybook:public": "npm run build-storybook && node scripts/stage-storybook.mjs",
    "test:storybook": "vitest run --project storybook"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "7.3.4",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.45.0",
    "@turf/boolean-point-in-polygon": "7.4.0",
    "@vercel/functions": "3.9.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "next": "^15.0.0",
    "next-themes": "^0.4.6",
    "pg": "8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.8",
    "stripe": "^17.0.0",
    "swagger-ui-react": "5.33.0",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.0.0",
    "@biomejs/biome": "^1.9.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "@redux-devtools/extension": "4.0.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-themes": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/nextjs-vite": "^10.6.1",
    "@types/node": "^22.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/swagger-ui-react": "5.18.0",
    "@vitest/browser-playwright": "^4.1.11",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "playwright": "^1.63.0",
    "postcss": "^8.4.0",
    "storybook": "^10.6.1",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  }
}
