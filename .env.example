# Supabase (local: `npx supabase start` prints these)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Server-only PostgreSQL connection: hosted Supabase transaction pooler with TLS.
# Local development keeps the direct connection supplied by supabase:env.
DATABASE_URL=
# Local disposable Supabase only; never point integration/E2E tests at hosted data.
SESSION_TEST_DATABASE_URL=

# Stripe (test mode keys only — never commit live keys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# OneMap
ONEMAP_API_KEY=

# Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
