# Supabase (local: `npx supabase start` prints these)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Session creation: server-only PostgreSQL URI. Apply migrations through 0009 first.
# Loopback development can omit TLS; hosted connections require sslmode=require or stronger.
DATABASE_URL=

# Stripe (test mode keys only — never commit live keys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# OneMap: registered account credentials, used only by the server for token generation.
# Optional: without both settings, authenticated users can enter venues manually.
ONEMAP_API_EMAIL=
ONEMAP_API_PASSWORD=

# Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
