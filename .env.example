# Supabase (local: `npx supabase start` prints these)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Session creation: server-only PostgreSQL URI. Apply migrations through 0008 first.
# Loopback development can omit TLS; hosted connections require sslmode=require or stronger.
DATABASE_URL=

# Stripe (test mode keys only — never commit live keys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# OneMap: server-only account credentials enable automatic token renewal.
# A complete email/password pair takes precedence over a supplied access token.
ONEMAP_API_EMAIL=
ONEMAP_API_PASSWORD=
# Optional alternative: a short-lived access token. Replace it before it expires
# and redeploy; a token alone cannot renew itself. Never use a NEXT_PUBLIC_ name.
# Without either authentication option, authenticated users can enter venues manually.
ONEMAP_API_TOKEN=

# Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Scheduler (sent by the cron as `Authorization: Bearer <secret>`)
CRON_SECRET=
